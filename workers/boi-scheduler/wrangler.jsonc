// boi-scheduler (FP1.1 PR 1 + FP5.9, P5 Step 5). Deployed on its own by .github/workflows/deploy-scheduler.yml,
// never by the site deploy. Not a site deploy: it doesn't count against the site's 1/day rule or the freeze.
//
// KV namespace IDs are NOT secrets: boi-snapshots and boi-snapshots-staging, created by Abhinav (#263, 29 Sep).
// Deploying still needs the secrets below; without SNAPSHOT_HMAC_KEY /publish and /read answer 401 to everything.
// Secrets (set by Abhinav with `wrangler secret put`, #263): SNAPSHOT_HMAC_KEY, BOI_SCHEDULER_DISPATCH_TOKEN (production only).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "boi-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": { "TARGET": "production", "GITHUB_REPO": "bricksofindia007/bricks-of-india" },
  "kv_namespaces": [{ "binding": "BOI_SNAPSHOTS", "id": "0af7352788ac4ba2a8c0440cfca849b1" }],
  // FP5.9: one dispatch slot per retailer (mybrickhouse :00, toycra :05); also the heartbeat ticks.
  // Order 0970: video publish pollers at their slot times (dispatch.ts). VID-P4 Sun/Wed/Fri 14:05 and 15:05 UTC;
  // VID-QP Mon/Wed/Fri 18:35 and 19:35 UTC (Tue/Thu/Sat IST). Each cron has a matching entry in dispatch.ts.
  "triggers": { "crons": ["0 3 * * *", "5 3 * * *", "5 14 * * 0,3,5", "5 15 * * 0,3,5", "35 18 * * 1,3,5", "35 19 * * 1,3,5"] },
  "env": {
    "staging": {
      "name": "boi-scheduler-staging",
      // The load generator's address and window are read from the flag store, not from this file.
      "vars": { "TARGET": "staging", "GITHUB_REPO": "bricksofindia007/bricks-of-india" },
      "kv_namespaces": [{ "binding": "BOI_SNAPSHOTS", "id": "0efa505226894c95b5e24d7ccd8612d1" }],
      // Staging crons: the freshness watchdog (10 3 * * *, 23 Oct 2026) and the keep-alive (Mondays and Thursdays 06:17 UTC). Drills per FP1.1 §8.
      // DRAFT (order 0890 item 11): removes the every-minute trigger that drives the staging load generator.
      // Do not merge until the owner says no measurement window is open. Re-add "* * * * *" before opening any window.
      "triggers": { "crons": ["10 3 * * *", "17 6 * * 1,4"] }
    }
  }
}
