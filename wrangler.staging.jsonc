{
  // Staging Worker for bricks-of-india. Own name, own R2 bucket, own Durable Object classes.
  // No KV: production does not bind KV. No custom route, no production bindings.
  // Deployed only by .github/workflows/deploy-cloudflare-staging.yml (manual dispatch).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bricks-of-india-staging",
  "main": "worker/staging-entry.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bricks-of-india-staging"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "bricksofindia-next-cache-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ],
  "vars": { "DEPLOY_TARGET": "staging", "STAGING_READONLY": "1" }
}
