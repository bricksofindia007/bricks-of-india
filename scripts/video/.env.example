# Bricks of India — Video Pipeline (VID-P4) — copy to .env and fill in.
# Never commit .env — it's gitignored (scripts/video/.gitignore).

# Google AI Studio project "Bricks-of-India-Social" — separate from the main
# site's GEMINI_API_KEY, kept isolated so social-video quota/billing never
# competes with the article-generation pipeline.
GEMINI_SOCIAL_API_KEY=

# Cerebras failover — same account/key already used by the main site's
# generation pipeline is fine to reuse here.
CEREBRAS_API_KEY=

# ElevenLabs Starter tier — Instant Voice Clone of the operator's voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Same Supabase project as the main site.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
